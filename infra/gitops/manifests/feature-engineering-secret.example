# NOT APPLIED BY ARGO. Template documenting the Secret shape that
# afie-feature-engineering's Deployment requires. Populate the real Secret
# out-of-band via one of:
#   - kubectl create secret generic feature-engineering-secrets \
#         -n afie-system \
#         --from-literal=postgres-connection-string="Host=...;Database=...;Username=...;Password=..."
#   - SealedSecrets / ExternalSecrets operator (preferred for prod GitOps)
#
# Argo skips this file because the filename has no manifest extension (.yaml).
# app-afie.yaml syncs infra/gitops/manifests with directory.recurse: true and
# would otherwise apply the REPLACE_ME values here as a real Secret.
apiVersion: v1
kind: Secret
metadata:
  name: feature-engineering-secrets
  namespace: afie-system
type: Opaque
stringData:
  postgres-connection-string: "Host=REPLACE_ME;Database=afie;Username=REPLACE_ME;Password=REPLACE_ME;Ssl Mode=Require"
